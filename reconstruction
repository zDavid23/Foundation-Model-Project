class FrameCNNEncoder2D(nn.Module):
    def __init__(self, in_channels, height, width, d_model):
        super().__init__()
        self.height = height
        self.width = width
        self.encoder = nn.Sequential(
            nn.Conv2d(in_channels, 16, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.Conv2d(16, 32, kernel_size=3, padding=1),
            nn.ReLU(),
        )
        self.fc = nn.Linear(32 * height * width, d_model)

    def forward(self, x):
        x = self.encoder(x)
        x = x.reshape(x.shape[0], -1)
        return self.fc(x)


class FrameCNNDecoder2D(nn.Module):
    def __init__(self, out_channels, height, width, d_model):
        super().__init__()
        self.height = height
        self.width = width
        self.fc = nn.Linear(d_model, 32 * height * width)
        self.decoder = nn.Sequential(
            nn.Conv2d(32, 16, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.Conv2d(16, out_channels, kernel_size=3, padding=1),
        )

    def forward(self, x):
        x = self.fc(x)
        x = x.reshape(x.shape[0], 32, self.height, self.width)
        return self.decoder(x)


class FrameCNNEncoder3D(nn.Module):
    def __init__(self, in_channels, height, width, depth, d_model):
        super().__init__()
        self.height = height
        self.width = width
        self.depth = depth
        self.encoder = nn.Sequential(
            nn.Conv3d(in_channels, 8, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.Conv3d(8, 16, kernel_size=3, padding=1),
            nn.ReLU(),
        )
        self.fc = nn.Linear(16 * height * width * depth, d_model)

    def forward(self, x):
        x = self.encoder(x)
        x = x.reshape(x.shape[0], -1)
        return self.fc(x)


class FrameCNNDecoder3D(nn.Module):
    def __init__(self, out_channels, height, width, depth, d_model):
        super().__init__()
        self.height = height
        self.width = width
        self.depth = depth
        self.fc = nn.Linear(d_model, 16 * height * width * depth)
        self.decoder = nn.Sequential(
            nn.Conv3d(16, 8, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.Conv3d(8, out_channels, kernel_size=3, padding=1),
        )

    def forward(self, x):
        x = self.fc(x)
        x = x.reshape(x.shape[0], 16, self.height, self.width, self.depth)
        return self.decoder(x)


class TransformerCNN(nn.Module):
    def __init__(self, sample_shape, d_model, num_heads, num_encoder_layers):
        super().__init__()
        self.sample_shape = sample_shape
        self.is_3d = len(sample_shape) == 5

        if self.is_3d:
            _, height, width, depth, channels = sample_shape
            self.encoder = FrameCNNEncoder3D(channels, height, width, depth, d_model)
            self.decoder = FrameCNNDecoder3D(channels, height, width, depth, d_model)
        else:
            _, height, width, channels = sample_shape
            self.encoder = FrameCNNEncoder2D(channels, height, width, d_model)
            self.decoder = FrameCNNDecoder2D(channels, height, width, d_model)

        self.transformer = nn.TransformerEncoder(
            nn.TransformerEncoderLayer(
                d_model=d_model, nhead=num_heads, batch_first=True
            ),
            num_encoder_layers,
        )

    def forward(self, x):
        # x: [batch, seq_len, H, W, C] or [batch, seq_len, H, W, D, C]
        batch_size, seq_len = x.shape[0], x.shape[1]
        if self.is_3d:
            frames = x.reshape(-1, *x.shape[2:])
            frames = frames.permute(0, 4, 1, 2, 3)
        else:
            frames = x.reshape(-1, *x.shape[2:])
            frames = frames.permute(0, 3, 1, 2)

        embeddings = self.encoder(frames)
        embeddings = embeddings.reshape(batch_size, seq_len, -1)
        latents = self.transformer(embeddings)

        recon_frames = self.decoder(latents.reshape(-1, latents.shape[-1]))
        if self.is_3d:
            recon_frames = recon_frames.permute(0, 2, 3, 4, 1)
        else:
            recon_frames = recon_frames.permute(0, 2, 3, 1)

        recon = recon_frames.reshape(batch_size, seq_len, *recon_frames.shape[1:])
        return recon, latents
